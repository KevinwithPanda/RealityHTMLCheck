{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realitycheck.dev/schemas/config-v1.json",
  "title": "RealityCheck project configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "baseUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "mode": { "enum": ["quick", "deep"] },
    "failOn": { "enum": ["critical", "major", "minor", "never"] },
    "qualityGate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "minimumScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "minimumCoveragePercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "maxWaivedFindings": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "baselinePolicy": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "maxAgeDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
        "requireSamePolicy": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["maxAgeDays"], "properties": { "maxAgeDays": true } },
        { "required": ["requireSamePolicy"], "properties": { "requireSamePolicy": { "const": true } } }
      ]
    },
    "output": { "type": "string", "minLength": 1 },
    "routes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "owners": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "ruleIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "include": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "waivers": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ruleId", "reason", "expires"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "ruleId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "selector": { "type": "string", "minLength": 1, "maxLength": 500 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
          "owner": { "type": "string", "minLength": 1, "maxLength": 500 },
          "expires": { "type": "string", "format": "date" },
          "include": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "selector", "assertion"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "selector": { "type": "string", "minLength": 1, "maxLength": 500 },
          "assertion": { "enum": ["exists", "visible", "enabled", "accessible-name", "attribute", "count", "no-horizontal-overflow", "minimum-size"] },
          "severity": { "enum": ["critical", "major", "minor", "info"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "titleZh": { "type": "string", "minLength": 1, "maxLength": 500 },
          "remediation": { "type": "string", "minLength": 1, "maxLength": 500 },
          "remediationZh": { "type": "string", "minLength": 1, "maxLength": 500 },
          "include": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min": { "type": "integer", "minimum": 0, "maximum": 100000 },
              "max": { "type": "integer", "minimum": 0, "maximum": 100000 },
              "attribute": { "type": "string", "minLength": 1, "maxLength": 500 },
              "equals": { "type": "string", "minLength": 1, "maxLength": 500 },
              "contains": { "type": "string", "minLength": 1, "maxLength": 500 },
              "minWidth": { "type": "integer", "minimum": 0, "maximum": 100000 },
              "minHeight": { "type": "integer", "minimum": 0, "maximum": 100000 }
            }
          }
        }
      }
    },
    "journeys": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "steps"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "titleZh": { "type": "string", "minLength": 1, "maxLength": 200 },
          "startPath": { "type": "string", "pattern": "^/(?!/)", "maxLength": 1000 },
          "severity": { "enum": ["critical", "major", "minor"] },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "contains": { "type": "object", "required": ["action"], "properties": { "action": { "enum": ["assert", "assert-url"] } } },
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["action", "path"],
                  "properties": { "action": { "const": "goto" }, "path": { "type": "string", "pattern": "^/(?!/)", "maxLength": 1000 } }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["action", "selector"],
                  "properties": { "action": { "const": "click" }, "selector": { "type": "string", "minLength": 1, "maxLength": 500 } }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["action", "selector", "key"],
                  "properties": {
                    "action": { "const": "press" },
                    "selector": { "type": "string", "minLength": 1, "maxLength": 500 },
                    "key": { "enum": ["Escape", "ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", "Home", "End", "Tab", "Shift+Tab"] }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["action", "path"],
                  "properties": { "action": { "const": "assert-url" }, "path": { "type": "string", "pattern": "^/(?!/)[^?#]*$", "maxLength": 1000 } }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["action", "selector", "assertion"],
                  "properties": {
                    "action": { "const": "assert" },
                    "selector": { "type": "string", "minLength": 1, "maxLength": 500 },
                    "assertion": { "enum": ["exists", "visible", "enabled", "accessible-name", "attribute", "count", "no-horizontal-overflow", "minimum-size"] },
                    "options": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "min": { "type": "integer", "minimum": 0, "maximum": 100000 },
                        "max": { "type": "integer", "minimum": 0, "maximum": 100000 },
                        "attribute": { "type": "string", "minLength": 1, "maxLength": 500 },
                        "equals": { "type": "string", "minLength": 1, "maxLength": 500 },
                        "contains": { "type": "string", "minLength": 1, "maxLength": 500 },
                        "minWidth": { "type": "integer", "minimum": 0, "maximum": 100000 },
                        "minHeight": { "type": "integer", "minimum": 0, "maximum": 100000 }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severity": { "enum": ["critical", "major", "minor"] },
        "navigationMs": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "domContentLoadedMs": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "ttfbMs": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "firstContentfulPaintMs": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "largestContentfulPaintMs": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "cumulativeLayoutShift": { "type": "number", "minimum": 0, "maximum": 100 },
        "requests": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "transferKb": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "domNodes": { "type": "integer", "minimum": 0, "maximum": 10000000 }
      },
      "anyOf": [
        { "required": ["navigationMs"], "properties": { "navigationMs": true } },
        { "required": ["domContentLoadedMs"], "properties": { "domContentLoadedMs": true } },
        { "required": ["ttfbMs"], "properties": { "ttfbMs": true } },
        { "required": ["firstContentfulPaintMs"], "properties": { "firstContentfulPaintMs": true } },
        { "required": ["largestContentfulPaintMs"], "properties": { "largestContentfulPaintMs": true } },
        { "required": ["cumulativeLayoutShift"], "properties": { "cumulativeLayoutShift": true } },
        { "required": ["requests"], "properties": { "requests": true } },
        { "required": ["transferKb"], "properties": { "transferKb": true } },
        { "required": ["domNodes"], "properties": { "domNodes": true } }
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severity": { "enum": ["critical", "major", "minor"] },
        "scope": { "enum": ["api", "all"] },
        "maxHttpErrors": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "maxFailedRequests": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "slowRequestMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxSlowRequests": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "maxThirdPartyRequests": { "type": "integer", "minimum": 0, "maximum": 10000 }
      },
      "dependentRequired": {
        "slowRequestMs": ["maxSlowRequests"],
        "maxSlowRequests": ["slowRequestMs"]
      },
      "anyOf": [
        { "required": ["maxHttpErrors"], "properties": { "maxHttpErrors": true } },
        { "required": ["maxFailedRequests"], "properties": { "maxFailedRequests": true } },
        { "required": ["maxSlowRequests"], "properties": { "maxSlowRequests": true } },
        { "required": ["maxThirdPartyRequests"], "properties": { "maxThirdPartyRequests": true } }
      ]
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxFailures"],
      "properties": {
        "severity": { "enum": ["critical", "major", "minor"] },
        "maxFailures": { "type": "integer", "minimum": 0, "maximum": 100 },
        "maxChecked": { "type": "integer", "minimum": 1, "maximum": 100 },
        "timeoutMs": { "type": "integer", "minimum": 500, "maximum": 15000 }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severity": { "enum": ["critical", "major", "minor"] },
        "titleMinLength": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "titleMaxLength": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "descriptionMinLength": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "descriptionMaxLength": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "requireCanonical": { "const": true },
        "requireViewport": { "const": true },
        "requireLang": { "const": true },
        "forbidNoindex": { "const": true },
        "requireSingleH1": { "const": true }
      },
      "anyOf": [
        { "required": ["titleMinLength"], "properties": { "titleMinLength": true } },
        { "required": ["titleMaxLength"], "properties": { "titleMaxLength": true } },
        { "required": ["descriptionMinLength"], "properties": { "descriptionMinLength": true } },
        { "required": ["descriptionMaxLength"], "properties": { "descriptionMaxLength": true } },
        { "required": ["requireCanonical"], "properties": { "requireCanonical": true } },
        { "required": ["requireViewport"], "properties": { "requireViewport": true } },
        { "required": ["requireLang"], "properties": { "requireLang": true } },
        { "required": ["forbidNoindex"], "properties": { "forbidNoindex": true } },
        { "required": ["requireSingleH1"], "properties": { "requireSingleH1": true } }
      ]
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severity": { "enum": ["critical", "major", "minor"] },
        "requiredHeaders": {
          "type": "array",
          "items": { "enum": ["content-security-policy", "strict-transport-security", "x-content-type-options", "referrer-policy", "permissions-policy"] },
          "uniqueItems": true
        },
        "forbidMixedContent": { "const": true },
        "secureForms": { "const": true },
        "maxThirdPartyOrigins": { "type": "integer", "minimum": 0, "maximum": 100 },
        "allowedThirdPartyOrigins": {
          "type": "array",
          "items": { "type": "string", "format": "uri", "pattern": "^https://[^/]+/?$" },
          "uniqueItems": true
        }
      },
      "anyOf": [
        { "required": ["requiredHeaders"], "properties": { "requiredHeaders": true } },
        { "required": ["forbidMixedContent"], "properties": { "forbidMixedContent": true } },
        { "required": ["secureForms"], "properties": { "secureForms": true } },
        { "required": ["maxThirdPartyOrigins"], "properties": { "maxThirdPartyOrigins": true } },
        { "required": ["allowedThirdPartyOrigins"], "properties": { "allowedThirdPartyOrigins": true } }
      ]
    },
    "crawl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxPages": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxDepth": { "type": "integer", "minimum": 0, "maximum": 8 },
        "include": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
