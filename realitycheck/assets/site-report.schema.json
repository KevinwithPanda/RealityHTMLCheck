{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realitycheck.local/schemas/site-report-v1.json",
  "title": "RealityCheck Site Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "toolVersion", "kind", "id", "baseUrl", "mode", "failOn", "startedAt", "finishedAt", "durationMs", "discovery", "summary", "pages"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "toolVersion": { "type": "string", "minLength": 1 },
    "kind": { "const": "site-audit" },
    "policyFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "id": { "type": "string", "minLength": 1 },
    "baseUrl": { "type": "string", "format": "uri" },
    "mode": { "enum": ["quick", "deep"] },
    "failOn": { "$ref": "#/$defs/failOn" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "number", "minimum": 0 },
    "discovery": { "$ref": "#/$defs/discovery" },
    "summary": { "$ref": "#/$defs/summary" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "oneOf": [{ "$ref": "#/$defs/completedPage" }, { "$ref": "#/$defs/failedPage" }] }
    }
  },
  "$defs": {
    "failOn": { "enum": ["critical", "major", "minor", "never"] },
    "severity": { "enum": ["critical", "major", "minor", "info"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "scenarioStatus": { "enum": ["passed", "completed-with-findings", "skipped", "unsupported", "failed"] },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "major", "minor", "info"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "major": { "type": "integer", "minimum": 0 },
        "minor": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "maxPages", "maxDepth", "visited", "discovered", "truncated", "warnings"],
      "properties": {
        "enabled": { "type": "boolean" },
        "maxPages": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxDepth": { "type": "integer", "minimum": 0, "maximum": 8 },
        "visited": { "type": "integer", "minimum": 0 },
        "discovered": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pagesRequested", "pagesCompleted", "pagesFailed", "averageScore", "minimumScore", "gateFailed", "findings", "scenariosCovered", "scenariosPassed"],
      "properties": {
        "pagesRequested": { "type": "integer", "minimum": 1 },
        "pagesCompleted": { "type": "integer", "minimum": 0 },
        "pagesFailed": { "type": "integer", "minimum": 0 },
        "averageScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "minimumScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "gateFailed": { "type": "boolean" },
        "findings": { "$ref": "#/$defs/counts" },
        "waivedFindings": { "type": "integer", "minimum": 0 },
        "gateViolations": { "type": "integer", "minimum": 0 },
        "scenariosCovered": { "type": "integer", "minimum": 0 },
        "scenariosPassed": { "type": "integer", "minimum": 0 }
      }
    },
    "titleTranslation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh-CN"],
      "properties": {
        "zh-CN": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": { "title": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fingerprint", "ruleId", "scenarioId", "severity", "confidence", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "minLength": 1 },
        "ruleId": { "type": "string", "minLength": 1 },
        "scenarioId": { "type": "string", "minLength": 1 },
        "severity": { "$ref": "#/$defs/severity" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "title": { "type": "string", "minLength": 1 },
        "waiver": { "$ref": "#/$defs/waiver" },
        "ownership": { "$ref": "#/$defs/ownership" },
        "translations": { "$ref": "#/$defs/titleTranslation" }
      }
    },
    "completedPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "finalUrl", "title", "status", "score", "gateFailed", "findings", "scenarioCounts", "scenarioStatuses", "findingDetails", "reportPath"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "finalUrl": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "status": { "const": "completed" },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "gateFailed": { "type": "boolean" },
        "findings": { "$ref": "#/$defs/counts" },
        "waivedFindings": { "type": "integer", "minimum": 0 },
        "owners": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "gateViolations": { "type": "array", "items": { "$ref": "#/$defs/gateViolation" } },
        "scenarioCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "scenarioStatuses": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/scenarioStatus" } },
        "findingDetails": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "reportPath": { "type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.html$" }
      }
    },
    "failedPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "status", "error"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "status": { "const": "failed" },
        "error": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "gateViolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "actual", "expected"],
      "properties": {
        "code": { "enum": ["severity-threshold", "minimum-score", "minimum-coverage", "max-waived-findings"] },
        "actual": { "type": "number", "minimum": 0 },
        "expected": { "type": "number", "minimum": 0 }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason", "expires"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "expires": { "type": "string", "format": "date" }
      }
    }
  }
}
