{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realitycheck.local/schemas/evidence-trust-v1.json",
  "title": "RealityCheck Evidence Trust Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "requireAttestation", "keys"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "1" },
    "kind": { "const": "evidence-trust-policy" },
    "requireAttestation": { "type": "boolean" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "name", "status"],
        "properties": {
          "keyId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "status": { "enum": ["trusted", "revoked"] },
          "notBefore": { "type": "string", "format": "date-time" },
          "notAfter": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
