{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realitycheck.local/schemas/report-v1.json",
  "title": "RealityCheck Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolVersion",
    "run",
    "target",
    "adapter",
    "config",
    "scenarios",
    "findings",
    "warnings",
    "score",
    "threshold"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "toolVersion": { "type": "string", "minLength": 1 },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "startedAt", "finishedAt", "durationMs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["quick", "deep"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "number", "minimum": 0 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedUrl", "finalUrl", "title"],
      "properties": {
        "requestedUrl": { "type": "string", "format": "uri" },
        "finalUrl": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "translations": { "$ref": "#/$defs/targetTranslations" }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "isolation", "capabilities"],
      "properties": {
        "name": { "enum": ["codex-browser", "project-playwright"] },
        "isolation": { "enum": ["fresh-context", "fresh-tab", "reloaded-tab"] },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowRemote", "failOn"],
      "properties": {
        "allowRemote": { "type": "boolean" },
        "failOn": { "enum": ["critical", "major", "minor", "never"] },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "width", "height", "touch"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
              "width": { "type": "integer", "minimum": 240, "maximum": 2560 },
              "height": { "type": "integer", "minimum": 320, "maximum": 2560 },
              "touch": { "type": "boolean" }
            }
          }
        },
        "qualityGate": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "minimumScore": { "type": "integer", "minimum": 0, "maximum": 100 },
            "minimumCoveragePercent": { "type": "integer", "minimum": 0, "maximum": 100 },
            "maxWaivedFindings": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "baselinePolicy": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "maxAgeDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
            "requireSamePolicy": { "type": "boolean" }
          },
          "anyOf": [
            { "required": ["maxAgeDays"], "properties": { "maxAgeDays": true } },
            { "required": ["requireSamePolicy"], "properties": { "requireSamePolicy": { "const": true } } }
          ]
        },
        "policyFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "translations": { "$ref": "#/$defs/reportTranslations" },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall",
        "baselinePenalty",
        "chaosPenalty",
        "counts",
        "totalFindings",
        "scoredFindings",
        "ignoredLowConfidenceFindings"
      ],
      "properties": {
        "overall": { "type": "integer", "minimum": 0, "maximum": 100 },
        "baselinePenalty": { "type": "number", "minimum": 0 },
        "chaosPenalty": { "type": "number", "minimum": 0 },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["critical", "major", "minor", "info"],
          "properties": {
            "critical": { "type": "integer", "minimum": 0 },
            "major": { "type": "integer", "minimum": 0 },
            "minor": { "type": "integer", "minimum": 0 },
            "info": { "type": "integer", "minimum": 0 }
          }
        },
        "totalFindings": { "type": "integer", "minimum": 0 },
        "scoredFindings": { "type": "integer", "minimum": 0 },
        "ignoredLowConfidenceFindings": { "type": "integer", "minimum": 0 },
        "waivedFindings": { "type": "integer", "minimum": 0 }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failOn", "met"],
      "properties": {
        "failOn": { "enum": ["critical", "major", "minor", "never"] },
        "met": { "type": "boolean" },
        "coveragePercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "actual", "expected"],
            "properties": {
              "code": { "enum": ["severity-threshold", "minimum-score", "minimum-coverage", "max-waived-findings"] },
              "actual": { "type": "number", "minimum": 0 },
              "expected": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "durationMs", "notes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["passed", "completed-with-findings", "skipped", "unsupported", "failed"]
        },
        "durationMs": { "type": "number", "minimum": 0 },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "translations": { "$ref": "#/$defs/scenarioTranslations" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "path": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "label": { "type": "string" }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ruleId",
        "scenarioId",
        "classification",
        "severity",
        "confidence",
        "fingerprint",
        "title",
        "summary",
        "url",
        "measurements",
        "evidence",
        "reproductionSteps",
        "remediation"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ruleId": { "type": "string", "minLength": 1 },
        "scenarioId": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["existing", "new", "worsened", "resolved"] },
        "severity": { "enum": ["critical", "major", "minor", "info"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "fingerprint": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "selector": { "type": "string", "minLength": 1 },
        "waiver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "reason", "expires"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 },
            "owner": { "type": "string", "minLength": 1 },
            "expires": { "type": "string", "format": "date" }
          }
        },
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "measurements": { "type": "object", "additionalProperties": true },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "reproductionSteps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "remediation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "technicalHints"],
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "technicalHints": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "translations": { "$ref": "#/$defs/findingTranslations" }
      }
    },
    "targetTranslations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zh-CN": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": {
            "title": { "type": "string" }
          }
        }
      }
    },
    "scenarioTranslations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zh-CN": {
          "type": "object",
          "additionalProperties": false,
          "required": ["notes"],
          "properties": {
            "notes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "findingTranslations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zh-CN": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "summary", "reproductionSteps", "remediation"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "summary": { "type": "string", "minLength": 1 },
            "reproductionSteps": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "remediation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["summary", "technicalHints"],
              "properties": {
                "summary": { "type": "string", "minLength": 1 },
                "technicalHints": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "reportTranslations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zh-CN": {
          "type": "object",
          "additionalProperties": false,
          "required": ["warnings"],
          "properties": {
            "warnings": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
