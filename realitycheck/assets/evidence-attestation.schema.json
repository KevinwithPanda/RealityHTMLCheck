{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realitycheck.local/schemas/evidence-attestation-v1.json",
  "title": "RealityCheck Evidence Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "toolVersion", "kind", "createdAt", "algorithm", "manifest", "signer", "signature"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "toolVersion": { "type": "string", "minLength": 1 },
    "kind": { "const": "evidence-attestation" },
    "createdAt": { "type": "string", "format": "date-time" },
    "algorithm": { "const": "Ed25519" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "artifactKind", "runId"],
      "properties": {
        "path": { "const": "evidence-manifest.json" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "artifactKind": { "enum": ["page-audit", "site-audit"] },
        "runId": { "type": "string", "minLength": 1 }
      }
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "publicKey"],
      "properties": {
        "keyId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "publicKey": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----[\\s\\S]+-----END PUBLIC KEY-----\\n?$" }
      }
    },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "minLength": 80, "maxLength": 100 }
  }
}
