{
  "$schema": "../../realitycheck/assets/config.schema.json",
  "baseUrl": "http://127.0.0.1:4193/fixed",
  "mode": "quick",
  "failOn": "major",
  "output": "../../.realitycheck/security-header-lab/fixed",
  "security": {
    "severity": "major",
    "requireSubresourceIntegrity": true,
    "headerPolicies": {
      "contentSecurityPolicy": {
        "requiredDirectives": ["default-src", "base-uri", "form-action", "frame-ancestors"],
        "forbiddenTokens": ["'unsafe-eval'", "*"]
      },
      "xContentTypeOptions": { "requireNosniff": true },
      "referrerPolicy": { "allowedValues": ["no-referrer", "strict-origin-when-cross-origin"] },
      "permissionsPolicy": { "disabledFeatures": ["camera", "microphone", "geolocation"] }
    }
  }
}
