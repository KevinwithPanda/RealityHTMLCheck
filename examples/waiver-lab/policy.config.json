{
  "$schema": "../../realitycheck/assets/config.schema.json",
  "baseUrl": "http://127.0.0.1:4175/examples/waiver-lab/index.html",
  "mode": "quick",
  "failOn": "never",
  "output": "../../.realitycheck/policy-lab",
  "qualityGate": {
    "minimumScore": 100,
    "minimumCoveragePercent": 100,
    "maxWaivedFindings": 0
  },
  "baselinePolicy": {
    "maxAgeDays": 30,
    "requireSamePolicy": true
  },
  "owners": [
    {
      "id": "web-platform",
      "name": "Web Platform",
      "ruleIds": ["custom-legacy-export-visible"],
      "include": ["/examples/waiver-lab/**"]
    }
  ],
  "checks": [
    {
      "id": "legacy-export-visible",
      "selector": "[data-testid=legacy-export]",
      "assertion": "visible",
      "severity": "major",
      "title": "Legacy customer export must remain available",
      "titleZh": "旧版客户导出功能必须保持可用",
      "remediation": "Restore the export control or complete the tracked replacement.",
      "remediationZh": "恢复导出控件，或完成已跟踪的替代方案。"
    }
  ]
}
