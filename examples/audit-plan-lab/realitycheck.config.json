{
  "$schema": "../../realitycheck/assets/config.schema.json",
  "baseUrl": "http://127.0.0.1:3000/",
  "mode": "deep",
  "failOn": "major",
  "viewports": [
    { "id": "phone-320", "width": 320, "height": 700, "touch": true },
    { "id": "phone-390", "width": 390, "height": 844, "touch": true },
    { "id": "tablet-768", "width": 768, "height": 1024, "touch": true }
  ],
  "crawl": {
    "enabled": true,
    "maxPages": 20,
    "maxDepth": 2,
    "include": ["/**"],
    "exclude": ["/logout/**", "/delete/**", "/purchase/**", "/checkout/**"]
  },
  "checks": [
    {
      "id": "release-action-visible",
      "selector": "[data-testid=release-action]",
      "assertion": "visible",
      "severity": "major",
      "title": "Release action must remain visible",
      "titleZh": "发布操作必须保持可见"
    }
  ],
  "journeys": [
    {
      "id": "release-overview",
      "title": "Release overview is reachable",
      "titleZh": "发布概览可访问",
      "startPath": "/",
      "severity": "major",
      "steps": [
        { "action": "assert", "selector": "body", "assertion": "visible" },
        { "action": "assert-url", "path": "/" }
      ]
    }
  ],
  "budgets": {
    "largestContentfulPaintMs": 2500,
    "cumulativeLayoutShift": 0.1,
    "requests": 100,
    "transferKb": 2000,
    "severity": "major"
  },
  "network": {
    "scope": "all",
    "maxHttpErrors": 0,
    "maxFailedRequests": 0,
    "slowRequestMs": 3000,
    "maxSlowRequests": 2,
    "maxThirdPartyRequests": 20,
    "severity": "major"
  },
  "links": { "maxFailures": 0, "maxChecked": 50, "timeoutMs": 5000, "severity": "major" },
  "metadata": {
    "titleMinLength": 5,
    "titleMaxLength": 70,
    "descriptionMinLength": 50,
    "descriptionMaxLength": 180,
    "requireCanonical": true,
    "requireViewport": true,
    "requireLang": true,
    "forbidNoindex": true,
    "requireSingleH1": true,
    "severity": "major"
  },
  "visual": {
    "baselineDirectory": ".realitycheck/visual-baselines",
    "maxDiffRatio": 0.002,
    "pixelThreshold": 28,
    "masks": [".current-time"],
    "severity": "major"
  },
  "security": {
    "requiredHeaders": ["content-security-policy", "x-content-type-options", "referrer-policy"],
    "forbidMixedContent": true,
    "secureForms": true,
    "maxThirdPartyOrigins": 2,
    "severity": "major"
  },
  "privacy": {
    "maxCookies": 10,
    "maxCookieBytes": 4096,
    "maxThirdPartyCookies": 0,
    "maxLocalStorageEntries": 20,
    "maxLocalStorageBytes": 131072,
    "maxSessionStorageEntries": 20,
    "maxSessionStorageBytes": 65536,
    "severity": "major"
  },
  "qualityGate": { "minimumScore": 95, "minimumCoveragePercent": 100, "maxWaivedFindings": 0 },
  "baselinePolicy": { "maxAgeDays": 30, "requireSamePolicy": true },
  "owners": [
    { "id": "web-platform", "name": "Web platform", "ruleIds": ["release-action-visible"] }
  ],
  "waivers": []
}
