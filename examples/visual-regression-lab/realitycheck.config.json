{
  "$schema": "../../realitycheck/assets/config.schema.json",
  "baseUrl": "http://127.0.0.1:4181/index.html",
  "mode": "quick",
  "failOn": "major",
  "output": "../../.realitycheck/visual-regression-lab",
  "visual": {
    "baselineDirectory": "baselines",
    "maxDiffRatio": 0.002,
    "pixelThreshold": 28,
    "masks": [".current-time"],
    "severity": "major"
  }
}
