{
  "name": "realityhtmlcheck",
  "version": "0.9.0",
  "description": "Verify AI-generated HTML exports locally — ZIP intake, portable notes, repeat-check evidence, and real-browser QA.",
  "type": "module",
  "bin": {
    "realityhtmlcheck": "realitycheck/scripts/audit.mjs",
    "realitycheck": "realitycheck/scripts/audit.mjs"
  },
  "scripts": {
    "realitycheck": "node realitycheck/scripts/audit.mjs",
    "note": "node realitycheck/scripts/audit.mjs note",
    "audit": "node realitycheck/scripts/audit.mjs audit",
    "demo": "node realitycheck/scripts/audit.mjs demo",
    "site:build": "node scripts/build-pages.mjs",
    "package:smoke": "node scripts/verify-packed-package.mjs",
    "test": "python -m unittest discover -s tests -v && node --test tests/*.test.mjs",
    "test:python": "python -m unittest discover -s tests -v",
    "test:node": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.12.1",
    "playwright-core": "1.61.1"
  },
  "keywords": [
    "codex",
    "playwright",
    "visual-testing",
    "visual-regression",
    "screenshot-testing",
    "accessibility",
    "api-testing",
    "link-checker",
    "metadata-audit",
    "seo-audit",
    "web-performance",
    "security-testing",
    "privacy-testing",
    "cookie-audit",
    "web-storage",
    "audit-plan",
    "test-plan",
    "github-actions",
    "responsive",
    "responsive-testing",
    "policy-as-code",
    "config-diff",
    "github-issues",
    "issue-tracker",
    "developer-experience",
    "release-gate",
    "release-readiness",
    "qa",
    "ai",
    "html-notes",
    "html-export",
    "zip-import",
    "baseline-comparison",
    "local-first",
    "knowledge-management"
  ],
  "license": "MIT",
  "author": "KevinwithPanda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KevinwithPanda/RealityHTMLCheck.git"
  },
  "homepage": "https://kevinwithpanda.github.io/RealityHTMLCheck/",
  "bugs": {
    "url": "https://github.com/KevinwithPanda/RealityHTMLCheck/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "docs/README.zh-CN.md",
    "docs/note-compatibility.zh-CN.md",
    "docs/assets",
    "realitycheck/SKILL.md",
    "realitycheck/agents",
    "realitycheck/assets",
    "realitycheck/references",
    "realitycheck/scripts/*.mjs",
    "realitycheck/scripts/*.py",
    "README.md",
    "LICENSE"
  ]
}
